# Next.js 서버 내부에서만 쓰는 upstream이다. 브라우저에 노출하지 않는다.
TRANSPORT_API_INTERNAL_URL=http://127.0.0.1:14001
# 공용 Dagster webserver(Manager ADR-54). UI는 location `kor-travel-transport`로 좁힌 이름 붙은 query만 보낸다.
TRANSPORT_DAGSTER_INTERNAL_URL=http://127.0.0.1:11002

# VWorld 지도용 공개 브라우저 키. 실제 값은 Git에서 제외되는 .env.local에 둔다.
# Next.js 빌드 시 포함되므로 값을 바꾸면 다시 빌드한다. 비워 두면 로컬 개발에서는 배경지도 없이
# 장소 마커만 그린다(Map in-repo VWorld style builder와 같은 fallback).
NEXT_PUBLIC_VWORLD_API_KEY=

# 운영 UI 로그인. 실제 값은 n150의 추적하지 않는 .env.server14에만 둔다.
TRANSPORT_UI_USER=admin
TRANSPORT_UI_PASSWORD=ad.min
TRANSPORT_UI_SESSION_SECRET=replace-with-at-least-32-random-characters
TRANSPORT_ADMIN_WRITE_TOKEN=
TRANSPORT_UI_PUBLIC_ORIGIN=http://127.0.0.1:12305
# 신뢰된 TLS reverse proxy가 X-Forwarded-For를 재작성하는 경우에만 true로 둔다.
TRANSPORT_UI_TRUST_PROXY=false
