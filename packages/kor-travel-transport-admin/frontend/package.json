{
  "name": "kor-travel-transport-admin-frontend",
  "version": "0.1.0-dev",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 12305",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 12305",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e:install": "playwright install --with-deps chromium firefox",
    "test:e2e": "playwright test",
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "test:e2e:parking": "playwright test --config playwright.parking.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.0.tgz",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.1.0-dev.9.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "vworld-map-core": "file:vendor/vworld-map-core-1.0.0.tgz",
    "vworld-map-web": "file:vendor/vworld-map-web-1.0.1.tgz",
    "@kor-travel/parking-ui": "file:../../../frontend/src"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supercluster": "7.1.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
