{
  "name": "kor-travel-transport-admin-frontend",
  "version": "0.1.0-dev",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 12305",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 12305",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "e2e:install": "playwright install --with-deps chromium firefox",
    "test:e2e": "playwright test",
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "test:e2e:parking": "playwright test --config playwright.parking.config.ts",
    "check:dependencies": "node node_modules/@kor-travel/ui/check-dependencies.mjs --lock package-lock.json --workspace \"\" --artifacts common-artifacts.json --source app --source components --source ../../../frontend/src",
    "doctor": "react-doctor . --scope full --yes --no-telemetry --no-supply-chain --no-parallel --blocking warning"
  },
  "dependencies": {
    "@kor-travel/parking-ui": "file:../../../frontend/src",
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.1.tgz",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.2.0.tgz",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "1.72.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.0",
    "vworld-map-core": "file:vendor/vworld-map-core-1.0.0.tgz",
    "vworld-map-web": "file:vendor/vworld-map-web-1.0.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supercluster": "7.1.3",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "undici": "8.12.4"
  }
}
