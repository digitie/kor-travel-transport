# parking-radar 로컬 실행 예시

DATABASE_URL=postgresql+asyncpg://parking_radar:parking_radar@postgres:5432/parking_radar
RELEASE_SHA=local
APP_TIMEZONE=Asia/Seoul

# 개발 기본값
ENABLE_SCHEDULER=false
ENABLE_MANUAL_COLLECT=true
SEED_SAMPLE_DATA=true
USE_SAMPLE_CLIENT_WHEN_NO_KEY=true
ENABLE_INCHEON_COLLECTION=true
ENABLE_INCHEON_FEE_COLLECTION=false
ENABLE_FEE_COLLECTION=false
COLLECT_INTERVAL_SECONDS=300
MANUAL_COLLECT_MIN_INTERVAL_SECONDS=300
UPSTREAM_RATE_LIMIT_BACKOFF_SECONDS=3600
API_TIMEOUT_SECONDS=15
ENABLE_FLIGHT_STATUS_MARKERS=true
FLIGHT_STATUS_CACHE_SECONDS=300
HOLIDAY_CACHE_SECONDS=86400

AIRPORT_CODES_CSV=CJJ,CJU,GMP,HIN,ICN,KUV,KWJ,MWX,PUS,RSU,TAE,USN,WJU,YNY
CORS_ORIGINS_CSV=http://localhost:3000
TRUSTED_HOSTS_CSV=localhost,127.0.0.1,testserver,backend
ENABLE_API_DOCS=true
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=14
BACKUP_COMMAND_TIMEOUT_SECONDS=120
BACKUP_UPLOAD_TIMEOUT_SECONDS=600
BACKUP_STORAGE_LIMIT_BYTES=8589934592

# 실데이터 전환 시 채우기
DATA_GO_KR_SERVICE_KEY=
KEX_EX_API_KEY=

# 고속도로·유가정보 수집(실행 시 python-krex-api와 Opinet Playwright 사용)
TRANSPORT_COLLECTION_ENABLED=false
TRANSPORT_COLLECT_INTERVAL_SECONDS=300
TRANSPORT_QUOTA_BACKOFF_SECONDS=3600
TRANSPORT_ROUTE_NOS_CSV=
TRANSPORT_CONZONE_IDS_CSV=
OPINET_BROWSER_ENABLED=true
OPINET_QUERY_LEVEL=sigungu
OPINET_BROWSER_CHANNEL=
OPINET_BROWSER_TIMEOUT_MS=60000

# 실데이터 권장 조합
# ENABLE_SCHEDULER=true
# SEED_SAMPLE_DATA=false
# USE_SAMPLE_CLIENT_WHEN_NO_KEY=false
# COLLECT_INTERVAL_SECONDS=600
# MANUAL_COLLECT_MIN_INTERVAL_SECONDS=600
# UPSTREAM_RATE_LIMIT_BACKOFF_SECONDS=3600
