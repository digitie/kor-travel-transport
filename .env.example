# kor-travel-transport 로컬 실행 예시

DATABASE_URL=postgresql+asyncpg://kor_travel_transport:kor_travel_transport@postgres:5432/kor_travel_transport
RELEASE_SHA=local
APP_TIMEZONE=Asia/Seoul

# 개발 기본값
ENABLE_SCHEDULER=false
ENABLE_MANUAL_COLLECT=true
SEED_SAMPLE_DATA=true
USE_SAMPLE_CLIENT_WHEN_NO_KEY=true
ENABLE_INCHEON_COLLECTION=true
ENABLE_INCHEON_FEE_COLLECTION=false
ENABLE_FEE_COLLECTION=false
COLLECT_INTERVAL_SECONDS=300
MANUAL_COLLECT_MIN_INTERVAL_SECONDS=300
UPSTREAM_RATE_LIMIT_BACKOFF_SECONDS=3600
API_TIMEOUT_SECONDS=15
ENABLE_FLIGHT_STATUS_MARKERS=true
FLIGHT_STATUS_CACHE_SECONDS=300
HOLIDAY_CACHE_SECONDS=86400

AIRPORT_CODES_CSV=CJJ,CJU,GMP,HIN,ICN,KUV,KWJ,MWX,PUS,RSU,TAE,USN,WJU,YNY
CORS_ORIGINS_CSV=http://localhost:3000
TRUSTED_HOSTS_CSV=localhost,127.0.0.1,testserver,backend
ENABLE_API_DOCS=true
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=14
BACKUP_COMMAND_TIMEOUT_SECONDS=120
BACKUP_UPLOAD_TIMEOUT_SECONDS=600
BACKUP_STORAGE_LIMIT_BYTES=8589934592

# 실데이터 전환 시 채우기
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
TRANSPORT_ADMIN_WRITE_TOKEN=
KAKAO_PLACE_COLLECTION_ENABLED=false
KAKAO_PLACE_MAX_CALLS_PER_DAY=5000
KAKAO_PLACE_MAX_CALLS_PER_MONTH=50000
KAKAO_PLACE_REQUEST_INTERVAL_SECONDS=0.2
KEX_EX_API_KEY=
# 휴게소 기준정보(data.go.kr)·휴게소 주유소 유가(EX) 수집(ADR-012). Map 이관의 원천이다.
REST_AREA_COLLECTION_ENABLED=false
# kor-travel-map이 읽는 /v1/service/exports/* 토큰(32자 이상). Map의 같은 값과 짝이다.
TRANSPORT_SERVICE_EXPORT_TOKEN=
# KRIC 인증 OpenAPI용 키. 공개 XLSX 기준정보 수집에는 필요하지 않는다.
KRIC_SERVICE_KEY=
KRIC_TIMETABLE_COLLECTION_ENABLED=false
# 마지막 시도부터 48시간 batch guard. 실패해도 즉시 재시도하지 않는다.
KRIC_TIMETABLE_MAX_CALLS=500
KRIC_TIMETABLE_REQUEST_INTERVAL_SECONDS=5

# 고속도로·유가정보 수집(실행 시 python-krex-api와 Opinet Playwright 사용)
TRANSPORT_COLLECTION_ENABLED=false
TRANSPORT_COLLECT_INTERVAL_SECONDS=300
TRANSPORT_QUOTA_BACKOFF_SECONDS=3600
TRANSPORT_ROUTE_NOS_CSV=
TRANSPORT_CONZONE_IDS_CSV=
OPINET_BROWSER_ENABLED=true
OPINET_QUERY_LEVEL=sigungu
OPINET_BROWSER_CHANNEL=
OPINET_BROWSER_TIMEOUT_MS=60000

# 변동이 적은 기준정보. KRIC rail job은 매일 due를 평가하지만 마지막 성공 뒤 48시간이 지나야
# 공개 XLSX를 한 번 읽는다. RustFS 설정이 필요하다.
RAIL_REFERENCE_COLLECTION_ENABLED=false
MARITIME_REFERENCE_COLLECTION_ENABLED=false
BUS_REFERENCE_COLLECTION_ENABLED=false
PORT_GUIDELINE_COLLECTION_ENABLED=true
FERRY_TIMETABLE_CACHE_SECONDS=300
FERRY_TIMETABLE_CACHE_MAX_ENTRIES=500
FERRY_TIMETABLE_MAX_DAYS_AHEAD=7
# 운항일 시간표는 오늘부터 10일을 DB에 저장한다. 순차 수집의 간격과 실행당 예산은 별개다.
FERRY_TIMETABLE_COLLECTION_ENABLED=false
FERRY_TIMETABLE_STORAGE_DAYS=10
FERRY_TIMETABLE_COLLECTION_MAX_PROVIDER_CALLS=280
FERRY_TIMETABLE_COLLECTION_INTERVAL_SECONDS=2
FERRY_TIMETABLE_MIN_INTERVAL_SECONDS=30
# TAGO 시간표는 public API에서도 provider를 보호하도록 cache miss를 기본 15분 간격으로 제한한다.
BUS_TIMETABLE_CACHE_SECONDS=900
BUS_TIMETABLE_CACHE_MAX_ENTRIES=500
BUS_TIMETABLE_MIN_INTERVAL_SECONDS=900

# 실데이터 권장 조합
# ENABLE_SCHEDULER=true
# SEED_SAMPLE_DATA=false
# USE_SAMPLE_CLIENT_WHEN_NO_KEY=false
# COLLECT_INTERVAL_SECONDS=600
# MANUAL_COLLECT_MIN_INTERVAL_SECONDS=600
# UPSTREAM_RATE_LIMIT_BACKOFF_SECONDS=3600
