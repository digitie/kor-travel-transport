{
  "name": "kor-travel-transport-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check:dependencies": "node node_modules/@kor-travel/ui/check-dependencies.mjs --lock package-lock.json --workspace \"\" --artifacts common-artifacts.json --source src",
    "lint": "eslint . --max-warnings=0",
    "doctor": "react-doctor . --scope full --yes --no-telemetry --no-supply-chain --no-parallel --blocking warning",
    "type-check": "next typegen && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.1.tgz",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.2.0.tgz",
    "@radix-ui/react-focus-scope": "file:vendor/radix-ui-react-focus-scope-1.3.1+kortravel.fix.2.tgz",
    "@tailwindcss/postcss": "4.3.5",
    "class-variance-authority": "0.7.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "postcss": "8.5.32",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7",
    "zustand": "5.1.0",
    "echarts": "6.1.0",
    "motion": "14.12.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "lightningcss": "file:vendor/lightningcss-1.33.0+nativecss.fix.4.tgz",
    "react-doctor": "0.9.22",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "undici": "8.12.4",
    "@testing-library/dom": "10.4.2",
    "lightningcss": "$lightningcss",
    "@radix-ui/react-focus-scope": "$@radix-ui/react-focus-scope"
  },
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": "22.23.1",
    "npm": "12.0.1"
  }
}
