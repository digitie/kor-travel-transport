# 192.168.1.14 운영 예시. 실제 값은 14번 서버의 .env.server14에만 둔다.
# 공용 PostgreSQL은 Manager가 host-network에서 제공한다. 아래 role/DB는 Manager bootstrap이
# 먼저 생성해야 하며 실제 비밀번호는 추적하지 않는 .env.server14에만 둔다.
DATABASE_URL=postgresql+asyncpg://kor_travel_transport_app:replace-with-transport-app-password@127.0.0.1:11000/kor_travel_transport
DAGSTER_POSTGRES_URL=postgresql://kor_travel_transport_dagster_app:replace-with-dagster-password@127.0.0.1:11000/kor_travel_transport_dagster
# 기존 운영은 Dagster metadata DB가 없었으므로 fresh start를 명시 승인한다. 이전
# metadata DB가 있으면 이 값을 비우고 LEGACY_DAGSTER_DATABASE_URL만 운영 파일에 둔다.
DAGSTER_METADATA_RESET_CONFIRM=START_FRESH_DAGSTER_METADATA_WITH_NO_LEGACY_STORE
RELEASE_SHA=unknown

PUBLIC_WEB_PORT=14002
PUBLIC_API_PORT=14001
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=14000
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=

ENABLE_SCHEDULER=true
SCHEDULER_MODE=dagster
ENABLE_MANUAL_COLLECT=false
RUN_DB_MIGRATIONS=true
SEED_SAMPLE_DATA=false
USE_SAMPLE_CLIENT_WHEN_NO_KEY=false
COLLECT_INTERVAL_SECONDS=300
SCHEDULER_SAFETY_BUFFER_SECONDS=120
MANUAL_COLLECT_MIN_INTERVAL_SECONDS=300
ENABLE_INCHEON_COLLECTION=true
ENABLE_INCHEON_FEE_COLLECTION=true
ENABLE_FEE_COLLECTION=false
UPSTREAM_RATE_LIMIT_BACKOFF_SECONDS=3600
API_TIMEOUT_SECONDS=15
HOLIDAY_CACHE_SECONDS=86400
FLIGHT_STATUS_CACHE_SECONDS=300
AIRPORT_CODES_CSV=CJJ,CJU,GMP,HIN,ICN,KUV,KWJ,MWX,PUS,RSU,TAE,USN,WJU,YNY
CORS_ORIGINS_CSV=http://192.168.1.14:14002,https://pr.digitie.mywire.org,https://pr-api.digitie.mywire.org
TRUSTED_HOSTS_CSV=192.168.1.14,pr.digitie.mywire.org,pr-api.digitie.mywire.org,localhost,127.0.0.1,testserver,backend
ENABLE_API_DOCS=false
APP_TIMEZONE=Asia/Seoul
DATA_GO_KR_SERVICE_KEY=replace-with-the-existing-operations-key
KEX_EX_API_KEY=replace-with-kex-key
# KRIC 인증 OpenAPI 키. 실제 값은 n150의 비추적 .env.server14에만 둔다.
KRIC_SERVICE_KEY=

# KRIC 공개 XLSX는 공용 RustFS에 원본 그대로 보관한다. RustFS bucket은 Manager가 초기화한다.
RUSTFS_ENDPOINT_URL=http://127.0.0.1:12101
RUSTFS_BUCKET=kor-travel-transport-raw
RUSTFS_ACCESS_KEY_ID=replace-with-manager-rustfs-access-key
RUSTFS_SECRET_ACCESS_KEY=replace-with-manager-rustfs-secret-key
RUSTFS_REGION_NAME=us-east-1
RUSTFS_RAW_PREFIX=provider-raw
# Manager의 loopback RustFS는 TLS 종단 전용 네트워크 안에서만 HTTP를 쓴다.
RUSTFS_ALLOW_INSECURE_HTTP=true
RAIL_REFERENCE_COLLECTION_ENABLED=false
MARITIME_REFERENCE_COLLECTION_ENABLED=false
PORT_GUIDELINE_COLLECTION_ENABLED=true
FERRY_TIMETABLE_CACHE_SECONDS=300
FERRY_TIMETABLE_MAX_DAYS_AHEAD=7
TRANSPORT_STATISTICS_CACHE_SECONDS=60
TRANSPORT_STATISTICS_MAX_CONCURRENT_MISSES=2
# Gateway listener는 host-network loopback `127.0.0.1:14003`으로 고정한다.
# 외부 공개가 필요하면 Manager TLS reverse proxy가 이 loopback endpoint만 upstream으로 쓴다.
DAGSTER_UI_USER=admin
DAGSTER_UI_PASSWORD=replace-with-dagster-gateway-password

# parking-radar와 분리된 transport 운영 UI/gateway. 실제 비밀번호·세션 비밀은
# n150의 추적하지 않는 .env.server14에만 둔다.
TRANSPORT_PUBLIC_API_PORT=12301
TRANSPORT_DAGSTER_PORT=12302
TRANSPORT_PUBLIC_WEB_PORT=12305
TRANSPORT_API_INTERNAL_URL=http://127.0.0.1:14001
TRANSPORT_DAGSTER_INTERNAL_URL=http://127.0.0.1:14004
TRANSPORT_UI_USER=admin
TRANSPORT_UI_PASSWORD=ad.min
TRANSPORT_UI_SESSION_SECRET=replace-with-32-or-more-random-characters
TRANSPORT_UI_PUBLIC_ORIGIN=https://transport.digitie.mywire.org
TRANSPORT_DAGSTER_USER=admin
TRANSPORT_DAGSTER_PASSWORD=ad.min
TRANSPORT_DAGSTER_PUBLIC_ORIGIN=https://transport-dagster.digitie.mywire.org

# 통합 교통정보 수집: 운영 승인·요금·브라우저 자원을 확인한 뒤 활성화한다.
TRANSPORT_COLLECTION_ENABLED=false
TRANSPORT_COLLECT_INTERVAL_SECONDS=300
TRANSPORT_QUOTA_BACKOFF_SECONDS=3600
TRANSPORT_ROUTE_NOS_CSV=
TRANSPORT_CONZONE_IDS_CSV=
OPINET_BROWSER_ENABLED=true
OPINET_QUERY_LEVEL=sigungu
OPINET_BROWSER_CHANNEL=
OPINET_BROWSER_TIMEOUT_MS=30000
BACKUP_DIR=/app/backups
BACKUP_PROXY_TIMEOUT_MS=900000
BACKUP_PROXY_BODY_TIMEOUT_MS=900000
BACKUP_RETENTION_COUNT=14
BACKUP_COMMAND_TIMEOUT_SECONDS=120
BACKUP_UPLOAD_TIMEOUT_SECONDS=600
BACKUP_STORAGE_LIMIT_BYTES=8589934592
