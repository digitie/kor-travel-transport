FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

RUN apk add --no-cache openssl

COPY backend/nginx/dagster-gateway.conf /etc/nginx/conf.d/default.conf

ARG RELEASE_SHA=unknown
ENV RELEASE_SHA=${RELEASE_SHA}

CMD ["/bin/sh", "-c", "printf '%s:%s\\n' \"$DAGSTER_UI_USER\" \"$(openssl passwd -apr1 \"$DAGSTER_UI_PASSWORD\")\" > /etc/nginx/.htpasswd && exec nginx -g 'daemon off;'"]
