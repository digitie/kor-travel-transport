# fuel 전용 읽기 listener. 기존 backend의 저장 reader만 사용한다.
map $http_origin $fuel_cors_origin {
    default "";
    "https://fuel.digitie.mywire.org" "https://fuel.digitie.mywire.org";
}
map $request_method $fuel_read_method {
    default 0;
    GET 1;
    HEAD 1;
    OPTIONS 1;
}
map "$request_method:$http_origin:$http_access_control_request_method" $fuel_preflight {
    default 0;
    "OPTIONS:https://fuel.digitie.mywire.org:GET" 1;
    "OPTIONS:https://fuel.digitie.mywire.org:HEAD" 1;
    ~^OPTIONS: 2;
}
# places 한 번의 개수 상한. 공개 UI는 종류당 300·합계 900 이하만 요청한다(transport-map.tsx).
# $arg_limit은 첫 값(이름 대소문자 무시, 디코드 없음)이고 Starlette는 마지막 값을 쓰므로, 판정한 값을
# upstream query 끝에 다시 붙여 backend가 실제로 쓰는 값을 고정한다(반복·인코딩 이름 우회 차단).
# 생략=900(backend 기본 1000이 상한을 넘으므로), 1~900=그대로, 900 초과 정수=900으로 낮춤,
# 그 밖(0·부호·앞자리 0·인코딩·문자)=422 problem+json(backend의 같은 종류 검증 오류와 같은 상태·형식).
map $arg_limit $fuel_places_limit {
    default "";
    "" 900;
    ~^([1-9][0-9]?|[1-8][0-9][0-9]|900)$ $arg_limit;
    ~^[1-9][0-9]*$ 900;
}
# places 동시 처리 상한(아래 limit_conn). 공개 사용자는 모바일 NAT 뒤에서 주소를 공유하므로 주소별이 아니라
# listener 전체를 한 key로 센다.
map $server_port $fuel_places_slot {
    default places;
}
limit_conn_zone $fuel_places_slot zone=fuel_places:1m;
# 소요 시간 access log 형식. 요청 줄($request)·query($args) 대신 클라이언트가 보낸 경로(디코드 전,
# query 제외)만 남긴다. 경로 안의 공개 식별자(주유소 id)는 남는다. 디코드 전 경로에는 공백이 없다.
# rt=gateway 전체, uct=upstream 연결, uht=upstream 첫 응답 header, urt=upstream 응답 끝까지(초),
# gz=gzip 압축비(압축하지 않으면 -). 공개 UI BFF(127.0.0.1)는 identity를 요청하므로 gz=-다.
# 읽는 법: docs/runbooks/request-timing-logs.md
map $request_uri $fuel_log_path {
    default "-";
    ~^([^?]*) $1;
}
log_format fuel_timing '$time_iso8601 $remote_addr "$request_method $fuel_log_path" $status $body_bytes_sent '
                       'rt=$request_time uct=$upstream_connect_time uht=$upstream_header_time '
                       'urt=$upstream_response_time ust=$upstream_status gz=$gzip_ratio';
server {
    listen 0.0.0.0:${TRANSPORT_FUEL_API_PORT};
    server_name _;
    access_log /dev/stdout fuel_timing;
    if ($fuel_read_method = 0) { return 405; }

    add_header Access-Control-Allow-Origin $fuel_cors_origin always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Accept, If-None-Match, Content-Type" always;
    add_header Access-Control-Expose-Headers "ETag, Retry-After" always;
    add_header Vary "Origin" always;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Set-Cookie;
    # 내부 계측(app·sql·pool·cpu)은 익명 공개 호출자에게 보내지 않는다.
    proxy_hide_header Server-Timing;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto $scheme;
    # 공개 listener 표지(클라이언트 값을 덮어쓴다). backend 장소 지도는 이 요청을 공개 몫으로 센다.
    proxy_set_header X-Transport-Listener public;
    proxy_http_version 1.1;
    # HEAD도 기존 GET reader를 사용하며 nginx가 응답 body를 생략한다.
    proxy_method GET;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    # backend는 places JSON을 압축하지 않는다(공개 상세 300곳 약 0.4MB). 낮은 수준으로 압축한다.
    # 이미 Content-Encoding이 있는 응답(가격 이력 gzip)은 nginx가 다시 압축하지 않는다.
    # 앞단 ingress가 Via를 붙여도 압축하도록 gzip_proxied any를 쓴다. nginx gzip은 200·403·404만
    # 압축하므로 오류 본문(problem+json, 1KiB 미만)은 대상에 넣지 않는다.
    gzip on;
    gzip_comp_level 1;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json;
    gzip_vary on;

    location = /health {
        access_log off;
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        proxy_pass http://127.0.0.1:12302;
    }

    location = /v1/transport/fuel/places {
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        default_type application/problem+json;
        # ADR-005 problem+json 다섯 항목. backend가 같은 종류의 query 검증 오류에 쓰는 422와 맞춘다.
        if ($fuel_places_limit = "") {
            return 422 '{"type":"about:blank","title":"Unprocessable Entity","status":422,"detail":"limit은 1 이상 900 이하의 정수여야 합니다(공개 gateway 상한 900).","instance":"/v1/transport/fuel/places"}';
        }
        # Starlette/FastAPI는 반복 query의 마지막 값을 사용한다.
        # kinds 혼용은 기존 reader가 422로 거절한다. 실제 zoom/bbox는 변경하지 않는다.
        proxy_pass http://127.0.0.1:12302/v1/transport/features/places?$args&kind=fuel_station&limit=$fuel_places_limit;
        # 팬·줌마다 오는 places 본문(공개 UI 300곳 약 0.4MB, 상한 900곳 약 1.2MB, 비압축)은 기본 버퍼(8×4k)를
        # 넘어 컨테이너 쓰기 계층의 proxy_temp 파일로 내려갔다. 요청당 최대 512KiB 메모리 버퍼로 받는다.
        # 공개 UI 크기(약 0.4MB)는 다 들어가 backend 연결을 바로 돌려준다. 그보다 큰 본문(limit 300 초과 직접 호출)은
        # 임시 파일 없이 클라이언트가 읽는 속도로 흘린다(그동안 backend 연결을 잡는다. send_timeout 60초가 한계).
        # gzip은 이 버퍼 뒤(출력 단계)에서 하므로 크기는 평문 기준이다.
        proxy_buffers 16 32k;
        proxy_max_temp_file_size 0;
        # 64MiB gateway에서 places 버퍼 합을 32×512KiB=16MiB(1/4) 이하로 묶는다. backend 공개 몫은 동시 계산 3·대기 8
        # (PLACES_MAX_RUNNING 4 − 관리 몫 1, PLACES_MAX_WAITING 8)이라 정상 부하는 이보다 작다. 넘으면 backend
        # 입장 거절과 같은 429 + Retry-After 2(공개 지도는 한 번 자동 재조회한다, lib/place-retry.ts)로 알린다.
        limit_conn fuel_places 32;
        limit_conn_status 429;
        error_page 429 = @fuel_places_busy;
    }

    # limit_conn 거절만 받는다(proxy_intercept_errors가 꺼져 있어 backend 429는 그대로 전달된다).
    # location에 add_header를 두면 server의 CORS add_header 상속이 끊기므로 같은 줄을 다시 적는다.
    location @fuel_places_busy {
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $fuel_cors_origin always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, If-None-Match, Content-Type" always;
        add_header Access-Control-Expose-Headers "ETag, Retry-After" always;
        add_header Vary "Origin" always;
        add_header Retry-After 2 always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"장소 지도 조회가 혼잡합니다. 잠시 후 다시 시도하세요.","instance":"/v1/transport/fuel/places"}';
    }

    location ~ ^/v1/transport/fuel/(stations|statistics|price-distribution|area-catalog|stations/[1-9][0-9]*/price-history)$ {
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        proxy_pass http://127.0.0.1:12302;
    }

    location / { return 404; }
}
