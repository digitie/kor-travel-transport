# fuel 전용 읽기 listener. 기존 backend의 저장 reader만 사용한다.
map $http_origin $fuel_cors_origin {
    default "";
    "https://fuel.digitie.mywire.org" "https://fuel.digitie.mywire.org";
}
map $request_method $fuel_read_method {
    default 0;
    GET 1;
    HEAD 1;
    OPTIONS 1;
}
map "$request_method:$http_origin:$http_access_control_request_method" $fuel_preflight {
    default 0;
    "OPTIONS:https://fuel.digitie.mywire.org:GET" 1;
    "OPTIONS:https://fuel.digitie.mywire.org:HEAD" 1;
    ~^OPTIONS: 2;
}
# places 한 번의 개수 상한. 공개 UI는 종류당 300·합계 900 이하만 요청한다(transport-map.tsx).
# $arg_limit은 첫 값(이름 대소문자 무시, 디코드 없음)이고 Starlette는 마지막 값을 쓰므로, 판정한 값을
# upstream query 끝에 다시 붙여 backend가 실제로 쓰는 값을 고정한다(반복·인코딩 이름 우회 차단).
# 생략=900(backend 기본 1000이 상한을 넘으므로), 1~900=그대로, 900 초과 정수=900으로 낮춤,
# 그 밖(0·부호·앞자리 0·인코딩·문자)=422 problem+json(backend의 같은 종류 검증 오류와 같은 상태·형식).
map $arg_limit $fuel_places_limit {
    default "";
    "" 900;
    ~^([1-9][0-9]?|[1-8][0-9][0-9]|900)$ $arg_limit;
    ~^[1-9][0-9]*$ 900;
}
# places 동시 처리 상한(아래 limit_conn). 같은 호스트의 공개 UI BFF(fuel-web, BACKEND_INTERNAL_URL=127.0.0.1:12307)와
# 그 밖의 직접 호출(fuel-api.digitie.mywire.org → OPNsense HAProxy → LAN 주소)을 다른 key로 센다. 직접 호출이 상한을
# 다 써도 공개 지도(BFF)는 막히지 않는다. HAProxy는 다른 호스트라 외부 호출은 127.0.0.1로 오지 않는다(listen은 IPv4만).
# 직접 호출자는 HAProxy 한 주소를 공유하고 모바일 NAT도 있으므로 그 안에서 주소별로 나누지 않는다.
map $remote_addr $fuel_places_bff_slot {
    default "";
    127.0.0.1 bff;
}
map $remote_addr $fuel_places_direct_slot {
    default direct;
    127.0.0.1 "";
}
limit_conn_zone $fuel_places_bff_slot zone=fuel_places_bff:1m;
limit_conn_zone $fuel_places_direct_slot zone=fuel_places_direct:1m;
# 장기 유가 추이(statistics/history) 동시 처리 상한. places와 달리 BFF·직접 호출을 **한 key**로 센다: 공개 BFF
# (/api/public/fuel/statistics/history)도 누구나 부를 수 있어 둘로 나누면 외부 호출자가 두 몫을 다 쓴다(PR #302 Popper P1).
# backend 동시 상한(4, 넘으면 429)과 같은 값이라 넘는 요청은 gateway가 backend까지 보내지 않고 거절한다. places와 zone이 달라
# 추이 조회가 지도 몫을, 지도가 추이 몫을 쓰지 않는다.
map $server_port $fuel_history_slot {
    default history;
}
limit_conn_zone $fuel_history_slot zone=fuel_history:1m;
# 소요 시간 access log 형식. 요청 줄($request)·query($args) 대신 클라이언트가 보낸 경로(디코드 전,
# query 제외)만 남긴다. 경로 안의 공개 식별자(주유소 id)는 남는다. 디코드 전 경로에는 공백이 없다.
# rt=gateway 전체, uct=upstream 연결, uht=upstream 첫 응답 header, urt=upstream 응답 끝까지(초),
# gz=gzip 압축비(압축하지 않으면 -). 공개 UI BFF(127.0.0.1)는 identity를 요청하므로 gz=-다.
# 읽는 법: docs/runbooks/request-timing-logs.md
map $request_uri $fuel_log_path {
    default "-";
    ~^([^?]*) $1;
}
log_format fuel_timing '$time_iso8601 $remote_addr "$request_method $fuel_log_path" $status $body_bytes_sent '
                       'rt=$request_time uct=$upstream_connect_time uht=$upstream_header_time '
                       'urt=$upstream_response_time ust=$upstream_status gz=$gzip_ratio';
server {
    # 클라이언트 송신 socket 버퍼를 256KiB(커널이 두 배로 잡아 약 512KiB)로 고정한다. 기본 자동 조정은 연결마다
    # 수 MiB(tcp_wmem 최대)까지 커질 수 있고 cgroup v2에서는 그 커널 버퍼도 64MiB 컨테이너 한도에 들어간다.
    # 256KiB는 RTT 50ms에서도 약 5MB/s라 공개 응답(약 1.2MB 이하)에는 충분하다.
    listen 0.0.0.0:${TRANSPORT_FUEL_API_PORT} sndbuf=256k;
    server_name _;
    access_log /dev/stdout fuel_timing;
    if ($fuel_read_method = 0) { return 405; }

    add_header Access-Control-Allow-Origin $fuel_cors_origin always;
    add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Accept, If-None-Match, Content-Type" always;
    # X-Limit-Applied: places 200에 backend가 붙이는 실제 적용 limit(아래 판정 값). gateway는 만들지 않고 통과만 시킨다.
    add_header Access-Control-Expose-Headers "ETag, Retry-After, X-Limit-Applied" always;
    add_header Vary "Origin" always;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    # 위 server 단위 Expose 한 줄만 나가게 한다(backend CORS 설정이 바뀌어도 중복되지 않는다).
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Set-Cookie;
    # 내부 계측(app·sql·pool·cpu)은 익명 공개 호출자에게 보내지 않는다.
    proxy_hide_header Server-Timing;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto $scheme;
    # 공개 listener 표지(클라이언트 값을 덮어쓴다). backend 장소 지도는 이 요청을 공개 몫으로 센다.
    proxy_set_header X-Transport-Listener public;
    proxy_http_version 1.1;
    # HEAD도 기존 GET reader를 사용하며 nginx가 응답 body를 생략한다.
    proxy_method GET;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    # backend는 places JSON을 압축하지 않는다(공개 상세 300곳 약 0.4MB). 낮은 수준으로 압축한다.
    # 이미 Content-Encoding이 있는 응답(가격 이력 gzip)은 nginx가 다시 압축하지 않는다.
    # 앞단 ingress가 Via를 붙여도 압축하도록 gzip_proxied any를 쓴다. nginx gzip은 200·403·404만
    # 압축하므로 오류 본문(problem+json, 1KiB 미만)은 대상에 넣지 않는다.
    gzip on;
    gzip_comp_level 1;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json;
    gzip_vary on;

    location = /health {
        access_log off;
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        proxy_pass http://127.0.0.1:12302;
    }

    location = /v1/transport/fuel/places {
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        default_type application/problem+json;
        # ADR-005 problem+json 다섯 항목. backend가 같은 종류의 query 검증 오류에 쓰는 422와 맞춘다.
        if ($fuel_places_limit = "") {
            return 422 '{"type":"about:blank","title":"Unprocessable Entity","status":422,"detail":"limit은 1 이상 900 이하의 정수여야 합니다(공개 gateway 상한 900).","instance":"/v1/transport/fuel/places"}';
        }
        # Starlette/FastAPI는 반복 query의 마지막 값을 사용한다.
        # kinds 혼용은 기존 reader가 422로 거절한다. 실제 zoom/bbox는 변경하지 않는다.
        proxy_pass http://127.0.0.1:12302/v1/transport/features/places?$args&kind=fuel_station&limit=$fuel_places_limit;
        # 팬·줌마다 오는 places 본문(공개 UI 300곳 약 0.40MB, 상한 900곳 약 1.18MB, 비압축 실측)은 기본 버퍼(8×4k)를
        # 넘어 컨테이너 쓰기 계층의 proxy_temp 파일로 내려갔다. 요청당 최대 512KiB 메모리 버퍼로 받고 임시 파일은 쓰지 않는다.
        # 공개 UI 크기(약 0.40MB)는 다 들어가 backend 연결을 바로 돌려준다. 그보다 큰 본문(limit 300 초과 직접 호출)은
        # 클라이언트가 읽는 속도로 흘리며 그동안 backend 연결과 이 상한의 자리를 잡는다. gzip은 이 버퍼 뒤에서 하므로
        # 크기는 평문 기준이다.
        proxy_buffers 16 32k;
        proxy_max_temp_file_size 0;
        # 쓰기 사이 간격 상한. 10초 동안 한 byte도 받지 않는 클라이언트는 끊는다. 조금씩 계속 읽는 클라이언트의
        # 전체 시간은 묶지 않으므로(nginx에 응답 전체 시한은 없다) 직접 호출 몫을 BFF와 나눈 것이 실제 방어다.
        send_timeout 10s;
        # 메모리: 요청당 proxy_buffers 512KiB + proxy_buffer_size 4KiB, gzip 응답(직접 호출만, BFF는 identity)은
        # zlib deflate 상태 약 264KiB(window 15·memLevel 8) + gzip_buffers 최대 128KiB(32×4k)를 더한다.
        # BFF 16×516KiB + 직접 8×908KiB ≈ 15.2MiB로 64MiB gateway의 1/4(export와 같은 기준) 이하다.
        # limit_conn zone은 worker끼리 공유하므로 worker 수와 무관하다(worker 자체 상주 메모리는 별도, probe가 잰다).
        # BFF 16은 backend 공개 몫(동시 계산 3·대기 8 = 11, 넘으면 backend가 바로 429)보다 크다.
        # 넘으면 backend 입장 거절과 같은 429 + Retry-After 2(공개 지도는 한 번 자동 재조회한다, lib/place-retry.ts).
        limit_conn fuel_places_bff 16;
        limit_conn fuel_places_direct 8;
        limit_conn_status 429;
        limit_conn_log_level warn;
        error_page 429 = @fuel_places_busy;
    }

    # limit_conn 거절만 받는다(proxy_intercept_errors가 꺼져 있어 backend 429는 그대로 전달된다).
    # instance는 클라이언트가 부른 gateway 경로다(backend 거절의 instance는 /v1/transport/features/places).
    # location에 add_header를 두면 server의 CORS add_header 상속이 끊기므로 같은 줄을 다시 적는다.
    location @fuel_places_busy {
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $fuel_cors_origin always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, If-None-Match, Content-Type" always;
        add_header Access-Control-Expose-Headers "ETag, Retry-After, X-Limit-Applied" always;
        add_header Vary "Origin" always;
        add_header Retry-After 2 always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"장소 지도 조회가 혼잡합니다. 잠시 후 다시 시도하세요.","instance":"/v1/transport/fuel/places"}';
    }

    # 장기 유가 추이. 유종당 최대 400점이라 1년·모든 유종(약 1,825점)은 비압축 약 0.42MB, 최대 5유종×400점은 약 0.46MB다
    # (점 하나 약 230 bytes). 기본 버퍼(8×4k)를 넘으면 proxy_temp 파일로 내려가므로 요청당 최대 256KiB 메모리 버퍼로 받고
    # 임시 파일은 쓰지 않는다. 그보다 큰 나머지는 클라이언트가 읽는 속도로 흘린다(BFF는 같은 호스트라 바로 읽는다).
    # 메모리(요청당, 모두 gzip 직접 호출로 잡은 최악): proxy 260KiB + zlib 264KiB + gzip_buffers 128KiB + 송신 socket 버퍼
    # 약 512KiB(sndbuf 256k) ≈ 1.1MiB × 4 ≈ 4.6MiB. places 두 몫(≈15.2MiB, socket 버퍼 제외)과 합쳐도 ≈19.8MiB로 64MiB의
    # 1/3 이하다. 응답을 커널에 다 넘기면 자리가 풀리므로 읽지 않는 연결이 송신 버퍼를 오래 쥐지 않게 keepalive를 짧게 둔다.
    # 넘으면 places와 같은 429 + Retry-After 2 problem+json이다.
    location = /v1/transport/fuel/statistics/history {
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        proxy_pass http://127.0.0.1:12302;
        proxy_buffers 8 32k;
        proxy_max_temp_file_size 0;
        send_timeout 10s;
        keepalive_timeout 5s;
        reset_timedout_connection on;
        limit_conn fuel_history 4;
        limit_conn_status 429;
        limit_conn_log_level warn;
        error_page 429 = @fuel_history_busy;
    }

    # limit_conn 거절만 받는다(backend 429는 그대로 전달된다). CORS 줄은 @fuel_places_busy와 같은 이유로 다시 적는다.
    location @fuel_history_busy {
        default_type application/problem+json;
        add_header Access-Control-Allow-Origin $fuel_cors_origin always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Accept, If-None-Match, Content-Type" always;
        add_header Access-Control-Expose-Headers "ETag, Retry-After, X-Limit-Applied" always;
        add_header Vary "Origin" always;
        add_header Retry-After 2 always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"유가 추이 조회가 혼잡합니다. 잠시 후 다시 시도하세요.","instance":"/v1/transport/fuel/statistics/history"}';
    }

    location ~ ^/v1/transport/fuel/(stations|statistics|price-distribution|area-catalog|stations/[1-9][0-9]*/price-history)$ {
        if ($fuel_preflight = 2) { return 403; }
        if ($fuel_preflight = 1) { return 204; }
        proxy_pass http://127.0.0.1:12302;
    }

    location / { return 404; }
}
