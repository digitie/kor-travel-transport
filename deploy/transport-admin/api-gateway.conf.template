# 이 파일은 공식 nginx 이미지의 http 문맥(conf.d)에 들어간다. 소요 시간 access log 형식이다.
# 요청 줄($request)·query($args) 대신 $uri만 남겨 export cursor·query 값을 로그에 싣지 않는다.
# rt=gateway 전체, uct=upstream 연결, uht=upstream 첫 응답 header, urt=upstream 응답 끝까지(초).
# 읽는 법: docs/runbooks/request-timing-logs.md
log_format transport_timing '$time_iso8601 $remote_addr "$request_method $uri" $status $body_bytes_sent '
                            'rt=$request_time uct=$upstream_connect_time uht=$upstream_header_time '
                            'urt=$upstream_response_time ust=$upstream_status';

# 공개 장소 조회 한 번의 개수 상한. 관리 지도 최대 900(transport-map.tsx)과 공개 유가 300을 넘지 않는다.
# 관리 UI 목록 검색(최대 5000)은 관리 BFF가 backend 12302를 직접 부르므로 이 listener를 지나지 않는다.
# $arg_limit은 첫 값(이름 대소문자 무시, 디코드 없음)이고 Starlette는 마지막 값을 쓰므로, 판정한 값을
# upstream query 끝에 다시 붙여 backend가 실제로 쓰는 값을 고정한다(반복·인코딩 이름 우회 차단).
# 생략=900, 1~900=그대로, 900 초과 정수=900으로 낮춤, 그 밖(0·부호·앞자리 0·인코딩·문자)=400.
map $arg_limit $transport_places_limit {
    default "";
    "" 900;
    ~^([1-9][0-9]?|[1-8][0-9][0-9]|900)$ $arg_limit;
    ~^[1-9][0-9]*$ 900;
}

server {
    listen 0.0.0.0:${TRANSPORT_PUBLIC_API_PORT};
    server_name _;
    # http 문맥 기본 형식(main, query 포함)을 대체한다. 공식 이미지는 stdout을 docker 로그로 모은다.
    access_log /dev/stdout transport_timing;

    location = /health {
        # Docker healthcheck(45초)가 반복 호출한다. 상태는 healthcheck로 보고 access log는 남기지 않는다.
        access_log off;
        proxy_pass http://127.0.0.1:12302;
        proxy_http_version 1.1;
        # backend TrustedHostMiddleware에는 public transport hostname을 추가하지
        # 않는다. 내부 loopback host로 고정해 기존 backend 설정을 보존한다.
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # 공개 장소 조회는 limit 상한을 고정한다(위 map). 정확 일치 location이 아래 정규식의
    # features/places보다 먼저 선택된다. 다른 query·kind/kinds·bbox·zoom은 그대로 전달한다.
    location = /v1/transport/features/places {
        limit_except GET { deny all; }
        default_type application/problem+json;
        if ($transport_places_limit = "") {
            return 400 '{"type":"about:blank","title":"Bad Request","status":400,"detail":"limit must be an integer from 1 to 900."}';
        }
        proxy_pass http://127.0.0.1:12302/v1/transport/features/places?$args&limit=$transport_places_limit;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # 공개 transport API는 저장 장소 조회와 제한된 항구 실시간 시간표를 포함한 읽기 endpoint만 제공한다.
    # 기본 backend의 주차·관리·백업/복원 경로를 이 listener로 전달하지 않는다.
    location ~ ^/v1/transport/(collector-status|providers|statistics|parking-lots|parking-lots/[1-9][0-9]*|highways/traffic|highways/incidents|fuel/(stations|statistics|regions)|fuel/stations/[1-9][0-9]*/price-history|features/places|bus/(terminals|timetable)|rail/(timetables|departures|stations)|rail/stations/[1-9][0-9]*/timetable|ports/timetables|ports/[^/]+/timetable)$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:12302;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # 일반철도 전체 역 안내의 최초 페이지 검산·저장만 충분히 기다린다. 쓰기는 허용하지 않는다.
    location ~ ^/v1/transport/rail/general/(catalog|stations|timetable|guide)$ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:12302;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # 운영 소비자 전용 export. 검증된 IP/CIDR만 허용하고 빈 설정은 모두 거절한다.
    location ^~ /v1/service/exports/ {
        include /etc/nginx/transport-export-allow.conf;
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:12302;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        # loopback backend의 peer 허용 조건을 클라이언트 XFF로 우회하지 못한다.
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        # T1 페이지(주유소 500행 약 1.2MB 비압축)는 기본 버퍼(8×4k)를 넘어 컨테이너 쓰기 계층의
        # proxy_temp 파일로 내려간다. 요청당 최대 2MiB 메모리 버퍼로 받아 backend 연결을 빨리 돌려주고,
        # 그보다 큰 본문(대형 참조 snapshot)은 임시 파일 없이 소비자가 읽는 속도로 그대로 흘린다.
        # 64MiB gateway에서 export 동시 요청 수가 적어(페이지 순차 조회) 메모리 상한 안에 든다.
        proxy_buffers 64 32k;
        proxy_max_temp_file_size 0;
    }

    # 같은 API의 MCP. 별도 소비자 CIDR로 raw export의 허용 범위를 넓히지 않는다.
    location = /mcp {
        include /etc/nginx/transport-mcp-allow.conf;
        limit_except GET POST { deny all; }
        proxy_pass http://127.0.0.1:12302;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For "";
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / { return 404; }
}
