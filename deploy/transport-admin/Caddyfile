{
    # Caddy가 세 공용 hostname의 ACME 인증서와 HTTPS redirect를 관리한다.
    # upstream은 모두 loopback listener라 TLS를 우회한 원격 접근이 불가능하다.
}

transport.digitie.mywire.org {
    reverse_proxy 127.0.0.1:12305
}

transport-api.digitie.mywire.org {
    reverse_proxy 127.0.0.1:12301
}

transport-dagster.digitie.mywire.org {
    reverse_proxy 127.0.0.1:12302
}
