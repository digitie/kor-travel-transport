map $http_origin $transport_dagster_same_origin {
    default 0;
    "${TRANSPORT_DAGSTER_PUBLIC_ORIGIN}" 1;
    "http://127.0.0.1:${TRANSPORT_DAGSTER_PORT}" 1;
    "http://localhost:${TRANSPORT_DAGSTER_PORT}" 1;
}

map "$request_method:$transport_dagster_same_origin" $transport_dagster_csrf_block {
    default 0;
    "POST:0" 1;
}

server {
    listen 127.0.0.1:${TRANSPORT_DAGSTER_PORT};
    server_name _;

    location = /health {
        auth_basic off;
        return 204;
    }

    location / {
        if ($transport_dagster_csrf_block) { return 403; }
        auth_basic "kor-travel-transport Dagster";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://127.0.0.1:14004;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
    }
}
